# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f9fdff"

# Main text color
theme[main_fg]="#424258"

# Title color for boxes
theme[title]="#424258"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#0a537c"

# Background color of selected item in processes box. #424258 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #fafdff gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#fafdff"

# Foreground color of selected item in processes box. Use #424258 so
# the row text stays readable on the lighter_bg highlight; the previous
# #0a537c produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#424258"

# Color of inactive/disabled text
theme[inactive_fg]="#6c6c65"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #5e5e71 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #424258 directly.
theme[graph_text]="#424258"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #424258 collapsed to the main fg.
theme[meter_bg]="#fafdff"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #0a7091 for a distinct accent instead of #5e5e71 which capped to white.
theme[proc_misc]="#0a7091"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#414766"
theme[mem_box]="#939384"
theme[net_box]="#424258"
theme[proc_box]="#0a537c"

# Box divider line and small boxes line color
theme[div_line]="#6c6c65"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#939384"
theme[temp_mid]="#9f8256"
theme[temp_end]="#424258"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#0a7091"
theme[cpu_mid]="#0a537c"
theme[cpu_end]="#414766"

# Mem/Disk free meter
theme[free_start]="#414766"
theme[free_mid]="#0a537c"
theme[free_end]="#0a7091"

# Mem/Disk cached meter
theme[cached_start]="#0a537c"
theme[cached_mid]="#0a7091"
theme[cached_end]="#414766"

# Mem/Disk available meter
theme[available_start]="#9f8256"
theme[available_mid]="#424258"
theme[available_end]="#424258"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#939384"
theme[used_mid]="#0a7091"
theme[used_end]="#0a537c"

# Download graph colors
theme[download_start]="#9f8256"
theme[download_mid]="#424258"
theme[download_end]="#424258"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#939384"
theme[upload_mid]="#0a7091"
theme[upload_end]="#0a537c"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#0a7091"
theme[process_mid]="#0a537c"
theme[process_end]="#414766"
